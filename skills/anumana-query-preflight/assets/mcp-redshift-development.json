{
  "mcpServers": {
    "anumana": {
      "command": "uv",
      "args": [
        "--directory",
        "REPLACE_WITH_ANUMANA_CHECKOUT",
        "run",
        "--no-sync",
        "anumana-mcp"
      ],
      "env": {
        "ANUMANA_TARGETS": "[{\"name\":\"redshift_db\",\"engine\":\"redshift\",\"dsn\":\"REPLACE_WITH_READ_ONLY_REDSHIFT_DSN\"}]"
      }
    }
  }
}
